<?xml version="1.0" encoding="utf-8"?>
<!--
  DK1 Dual-Arm URDF
  Generated from STEP file analysis of DK1-X-Tabletop assembly (DK1-X Bottom up).

  ── World Coordinate Frame ──────────────────────────────────────────────────
    Z-up, Y-forward convention (standard ROS/robotics):

      X+  →  RIGHT   (from the operator's perspective facing the robot)
      Y+  →  FORWARD (away from the mounting frame, into the workspace)
      Z+  →  UP

    Origin is at the center of the front aluminum crossbar at table height.

  ── Arm Mounting (from STEP CAD data) ───────────────────────────────────────
    Both follower arms are mounted on the front crossbar, symmetric about X=0:

      Right arm base:  xyz=( 0.290,  0.000,  0.040) m   rpy=(0, 0, π/2)
      Left  arm base:  xyz=(-0.290,  0.000,  0.040) m   rpy=(0, 0, π/2)

    Arm separation (center-to-center): 580 mm
    Mount height above crossbar: 40 mm
    Both arms have identical orientation (not mirrored); they differ only
    in their lateral (X) position.

  ── Overhead Camera ─────────────────────────────────────────────────────────
    Mounted on a 30x30mm vertical mast at the front-center of the frame:

      Position:  xyz=(0.000, 0.011, 0.479) m
      Tilt:      45° downward toward workspace   rpy=(-2.356, 0, 0)

  ── Mesh Paths ──────────────────────────────────────────────────────────────
    Relative to this URDF file. Both arms share the same mesh files
    (meshes/) since they are physically identical.
-->
<robot name="dk1_dual_arm">

  <!-- ============================================================ -->
  <!-- World / mounting structure base                               -->
  <!-- ============================================================ -->
  <link name="world"/>

  <!-- ============================================================ -->
  <!-- Front crossbar: HFS8-4080-700, 700mm aluminum extrusion      -->
  <!-- Runs along X at Y=0, centered at Z=0.020 (half of 40mm)     -->
  <!-- ============================================================ -->
  <!-- Front crossbar: HFS8-4080-700 aluminum extrusion
       700mm long (X), 80mm deep (Y), 40mm tall (Z)
       Runs along X axis at Y=0 (front of frame), Z=0..40mm
       Note: simplified as box, real profile has T-slots -->
  <link name="front_crossbar">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.700 0.080 0.040"/>
      </geometry>
      <material name="aluminum"><color rgba="0.80 0.80 0.80 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.700 0.080 0.040"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_crossbar_joint" type="fixed">
    <parent link="world"/>
    <child link="front_crossbar"/>
    <!-- Center of crossbar: X=0, Y=-40mm (front face at Y=0), Z=20mm (center of 40mm height) -->
    <origin xyz="0.0 0.0 0.020" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- Camera mast: HFS6-3030-400, vertical 30x30mm extrusion       -->
  <!-- At front-center of frame, rises 400mm in Z                   -->
  <!-- ============================================================ -->
  <!-- Camera mast: HFS6-3030-400 aluminum extrusion
       30x30mm cross-section, 400mm tall
       Rises from top of front crossbar (Z=40mm) to Z=440mm
       Note: simplified as box, real profile has T-slots -->
  <link name="camera_mast">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.400"/>
      </geometry>
      <material name="aluminum"><color rgba="0.80 0.80 0.80 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.400"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_mast_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_mast"/>
    <!-- Center of mast: sits on top of crossbar (Z=0.040), rises 400mm, center at Z=0.240 -->
    <origin xyz="0.0 0.011 0.240" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- Overhead context camera (top of vertical 30x30 mast)         -->
  <!-- STEP position: (0, 478.81, -10.65) mm                        -->
  <!-- Camera Z-axis (optical): (0, -0.707, -0.707) in STEP         -->
  <!-- ============================================================ -->
  <link name="overhead_camera"/>
  <joint name="overhead_camera_mount" type="fixed">
    <parent link="world"/>
    <child link="overhead_camera"/>
    <origin xyz="0.0 0.01065 0.47881" rpy="-2.356194490192345 0 0"/>
  </joint>

