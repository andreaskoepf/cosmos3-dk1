diff --git a/cosmos_framework/model/vfm/omni_mot_model.py b/cosmos_framework/model/vfm/omni_mot_model.py
index 9e93f98..4470ea2 100644
--- a/cosmos_framework/model/vfm/omni_mot_model.py
+++ b/cosmos_framework/model/vfm/omni_mot_model.py
@@ -4266,12 +4266,27 @@ class OmniMoTModel(ImaginaireModel):
         from cosmos_framework.utils.vfm.lora import inject_lora_pre_fsdp
 
         self.lora_alpha = lora_alpha
-        return inject_lora_pre_fsdp(
+        network = inject_lora_pre_fsdp(
             network,
             lora_rank=lora_rank,
             lora_alpha=lora_alpha,
             lora_target_modules=lora_target_modules,
         )
+        # Un-freeze selected non-LoRA modules so they train fully alongside LoRA.
+        # LoRA injection froze every non-adapter param; a brand-new embodiment's
+        # action projection (action2llm/llm2action) must be LEARNED, not adapted.
+        # Driven by $LORA_ALSO_TRAIN (comma-separated name substrings).
+        import os
+        also = [t.strip() for t in os.environ.get("LORA_ALSO_TRAIN", "").split(",") if t.strip()]
+        if also:
+            n = 0
+            for name, p in network.named_parameters():
+                if any(t in name for t in also):
+                    p.requires_grad_(True)
+                    n += p.numel()
+            from cosmos_framework.utils import log
+            log.info(f"LoRA: also training {n:,} non-LoRA params matching {also}")
+        return network
 
