index f7fd14e..b6fa0a2 100644
--- a/cosmos_framework/configs/base/config.py
+++ b/cosmos_framework/configs/base/config.py
@@ -98,4 +98,12 @@ def make_config() -> Config:
     # Register shipped experiments explicitly.
     import cosmos_framework.configs.base.experiment.sft.vision_sft_nano  # noqa: F401
     import cosmos_framework.configs.base.experiment.sft.vision_sft_super  # noqa: F401
+
+    # Register external experiment modules listed in $COSMOS_EXTRA_EXPERIMENTS
+    # (comma-separated importable module names; must be on PYTHONPATH). Lets
+    # out-of-tree projects (e.g. cosmos-dk1) register their experiments without
+    # editing this file. Their cs.store(group="experiment", ...) side-effects fire on import.
+    import importlib, os  # noqa: E401
+    for _mod in filter(None, (m.strip() for m in os.environ.get("COSMOS_EXTRA_EXPERIMENTS", "").split(","))):
+        importlib.import_module(_mod)
     return c
